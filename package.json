{
  "name": "yuri-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "admin:reset": "node --env-file=.env --import tsx scripts/create-admin.ts reset",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@giscus/react": "^3.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "harmonyos-sans-sc-webfont-splitted": "1.1.0",
    "katex": "0.16.47",
    "lucide-react": "^1.68.0",
    "minisearch": "^7.2.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "yaml": "2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./yuri-blog/*"
      ]
    }
  },
  "include": [
    "yuri-blog/next-env.d.ts",
    "yuri-blog/**/*.ts",
    "yuri-blog/**/*.tsx",
    "yuri-blog/**/*.mts",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../.next/types/**/*.ts",
    "../.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".local",
    "tests"
  ]
}
